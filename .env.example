# Tu API key de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Puerto donde corre el servidor
PORT=3000

# Nivel de log (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Si es "true", /api/chat no llama a Claude (útil para probar front o CI sin API)
DEV_SKIP_LLM=false

# Timeout del fetch a portales (ms)
SCRAPER_TIMEOUT_MS=25000

# SQLite (sesiones + caché del scraper). Por defecto: ./data/garaje.db
# SQLITE_PATH=/var/lib/elgaraje/garaje.db

# TTL de la caché de resultados de portales (ms). Default: 30 minutos
# SCRAPER_CACHE_TTL_MS=1800000

# Desactivar caché del scraper (tests / debug)
# SCRAPER_CACHE_DISABLED=false

# Plantillas configurables para portales con scraper genérico.
# Placeholders disponibles: {query}, {precioMin}, {precioMax}
# ROSARIOGARAGE_SEARCH_URL_TEMPLATE=https://www.rosariogarage.com/buscar?texto={query}
# MASPOCOVENDO_SEARCH_URL_TEMPLATE=https://www.maspocovendo.com.ar/busqueda?buscar={query}

# Proveedor de fetch para traer el HTML (resuelve JS + anti-bot). Default: direct (fetch propio).
#   direct    -> fetch directo (gratis)
#   firecrawl -> usa Firecrawl (requiere FIRECRAWL_API_KEY)
#   http      -> cualquier servicio web→API; requiere SCRAPER_FETCH_URL_TEMPLATE con {url}
# SCRAPER_PROVIDER=direct
# FIRECRAWL_API_KEY=fc-xxxxxxxx
# SCRAPER_FETCH_URL_TEMPLATE=https://api.tuservicio.com/scrape?render=true&url={url}
# SCRAPER_FETCH_AUTH=Bearer xxxxxxxx

# Async: la búsqueda interactiva no bloquea con el render; los portales lentos vuelven "buscando…"
# y el front re-consulta. Requiere la API key (camelCase) de ScraperAPI.
# SCRAPER_ASYNC=true
# SCRAPERAPI_API_KEY=tu_key

# Auto-refresh en background de las búsquedas con alertas activas (minutos). 0 = desactivado.
# AUTO_REFRESH_MINUTES=0

# --- MercadoLibre API oficial (JSON real, sin scraping ni anti-bot) ---
# 1) Registrá una app GRATIS en https://developers.mercadolibre.com.ar/ (botón "Crear app").
# 2) En "Redirect URI" de la app poné EXACTAMENTE: http://localhost:3000/api/ml/callback
# 3) Copiá App ID (client_id) y Secret Key (client_secret) acá abajo.
# 4) Arrancá el server y entrá a http://localhost:3000/api/ml/auth para autorizar (1 sola vez).
#    Los tokens se guardan solos en la DB y se refrescan automáticamente.
# ML_CLIENT_ID=1234567890123456
# ML_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ML_REDIRECT_URI=http://localhost:3000/api/ml/callback
